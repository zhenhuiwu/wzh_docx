# 复制为 server/.env 后按需修改。.env 已被 .gitignore 忽略，不要提交真实密钥。
# 数据库只支持 SQLite；相对路径以启动后端时的工作目录（server/）为准。
DATABASE_URL=sqlite:///./data/app.db
FILE_DATA_DIR=./data/files
# FILE_MAX_BYTES=20971520

# AI 编写（OpenAI 兼容接口）。留空时 AI 功能不可用，其余功能正常。
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# AI_CONTEXT_TOKENS=32000
# AI_READ_TIMEOUT_SECONDS=600  # 单次模型请求无响应的等待秒数，不限制整份文档总时长
# AI_REASONING_EFFORT=     # 可选 none/minimal/low/medium/high/xhigh/max，留空用模型默认

# 通过 HTTPS 访问时设为 1，会话 Cookie 带 Secure 标记。
# COOKIE_SECURE=1
